# Merge these names into the existing backend environment through your secret store.
# Do not enable payments until rates, provider account and webhook tests pass.
STOREFRONT_CHECKOUT_ENABLED=false
STOREFRONT_URL=https://your-store.example
STOREFRONT_CURRENCY=PKR
# Basis points: 0 means explicitly configured zero tax, 500 means 5%.
STOREFRONT_TAX_BPS=0
# Existing provider configuration names; supply securely, never in source control.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
DESIGN_STUDIO_ENABLED=false
# Private path must be outside the public uploads directory. Back up with database.
DESIGN_PRIVATE_DIR=/var/lib/teamcore/designs
